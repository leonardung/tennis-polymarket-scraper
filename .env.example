# Copy to .env -- which is gitignored, because the token below is a credential.
#
#     cp .env.example .env

# The Cloudflare tunnel token, from the tunnel's "Install and run a connector"
# page. It is the whole tunnel: anyone holding it can serve traffic as this
# hostname, so it never goes on a command line or into git.
CLOUDFLARED_TOKEN=eyJhIjoi...

# Who the containers run as. Both the capture and the dashboard write to the
# bind-mounted ./data, so this has to be whoever owns it on the host -- `id -u`
# and `id -g`. 1000 is the usual first account and the default here.
#PUID=1000
#PGID=1000

# Log timestamps only; nothing in the capture reads the clock's zone. Unset
# means UTC, which is what a container has if you do not tell it otherwise.
#TZ=Europe/Paris
